    {
      "parameters": {
        "jsCode": "// Get the data from the previous node\nconst inputData = items[0].json;\n\n// Initialize variables\nlet score = 0;\nlet category = \"Low Priority\";\n\n// 1. Check for professional email domains (Logic)\nif (inputData.email.includes('.biz') || inputData.email.includes('.com')) {\n  score += 40;\n}\n\n// 2. Check for \"High Value\" company names (Data Analysis)\nconst companyName = inputData.company.name.toLowerCase();\nif (companyName.includes('romaguera') || companyName.includes('corp')) {\n  score += 40;\n}\n\n// 3. Add bonus points for complex company phrases\nif (inputData.company.catchPhrase.length > 20) {\n  score += 20;\n}\n\n// Final Category Assignment\nif (score >= 80) {\n  category = \"High Priority - Ready\";\n} else if (score >= 50) {\n  category = \"Medium Priority\";\n}\n\n// Return the new enriched object\nreturn {\n  json: {\n    original_email: inputData.email,\n    company_name: inputData.company.name,\n    lead_score: score,\n    lead_category: category,\n    status: \"Processed\"\n  }\n};"
      },
